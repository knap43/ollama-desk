[Desktop Entry]
Type=Application
Name=Ollama Desk
Comment=Chat with local models and let them lend a hand on your desktop
Exec=ollama-desk %F
Icon=io.github.ollamadesk.OllamaDesk
Terminal=false
Categories=Utility;GTK;
Keywords=AI;LLM;Ollama;chat;assistant;
StartupNotify=true
Actions=quick-ask;

[Desktop Action quick-ask]
Name=Quick Ask
Exec=ollama-desk --quick
